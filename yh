#!/data/data/com.termux/files/usr/bin/bash
# Point d'entrée de YH-Termux.

set -euo pipefail

# Le fichier peut être lancé directement ou via le lien $PREFIX/bin/yh créé
# par install.sh. Résoudre le lien est indispensable dans le second cas.
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PROJECT_ROOT="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
export PROJECT_ROOT

if [[ -x "$PROJECT_ROOT/bin/yh-tui" ]]; then
  exec "$PROJECT_ROOT/bin/yh-tui" "$@"
fi

# shellcheck source=core/main.sh
source "$PROJECT_ROOT/core/main.sh"
yh_main "$@"
